.rocketride/
.env

# Dependencies and build output (machine-generated)
**/node_modules/
**/dist/
.env.deploy

# Secrets (belt and braces — never commit any env file)
.env
.env.*
!.env.example
**/.env
**/.env.*
**/env.generated.ts

# Python / virtualenvs
**/.venv/
**/__pycache__/
*.pyc

# Build + tooling artifacts
**/.rsbuild/
**/.next/
tools/.styles-raw.css
/tmp/

# External repo with its own remote (rocketride-org/branding)
/branding/

# Disabled nested git history
**/.git.disabled/

# external evaluation clone (own repo; not ours to version)
vendor/reel-creation/

# compiled test inputs (regenerated by the domain test command)
tools/tests/domain/.build/
tools/tests/domain/.build-lib/

# the extension materialises an app workspace at <root>/<app slug>/; our sources live in launchkit-src/
/launchkit/

# the package resolves its peers through the app install (ADOPT.md); never commit the link
/design-system/node_modules


# dev-only appState checkpoints served by the preview (never deployed: the packer ships tracked files only)
/apps/launchkit/public/dev/

# local Python env for the vendored reel toolchain
/vendor/reel-creation/.venv/
/vendor/reel-creation/build/

# studio forge (local render service): installs and outputs
/services/studio-forge/node_modules/
/services/studio-forge/out/
