    },
    {
      "id": "tool_exa_search_1",
      "provider": "tool_exa_search",
      "name": "Exa Search",
      "config": {
        "type": "tool_exa_search",
        "apikey": "${ROCKETRIDE_EXA_KEY}",
        "numResults": 10,
        "useAutoprompt": true,
        "searchType": "auto",
        "includeText": true
      },
      "control": [
        {
          "classType": "tool",
          "from": "agent_rocketride_1"
        }
      ],
      "ui": {
        "position": {
          "x": 420,
