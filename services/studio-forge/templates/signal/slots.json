{
  "concept": "signal",
  "title": "Signal",
  "tagline": "An incoming transmission that decodes into your launch. Dark terminal, matrix decode, one zoom, a held lockup.",
  "duration": 24,
  "column": 900,
  "faces": { "anton": 0.46, "mono": 0.5, "sg": 0.6 },
  "beats": [
    { "t": "0.0-1.8", "what": "Hook. A small framing line, then one short detection line with a cursor.", "slots": ["s1_head", "s1_line"] },
    { "t": "1.8-4.2", "what": "A decrypting bar fills. One label.", "slots": ["s2_label"] },
    { "t": "4.2-6.0", "what": "Who this is for. A label, then the audience word decodes in.", "slots": ["s3_label", "s3_audience"] },
    { "t": "6.0-9.0", "what": "The reveal on the music drop: the app name, then a second short line.", "slots": ["drop_l1", "drop_l2"] },
    { "t": "9.0-10.6", "what": "The single most important true fact, two lines, the second in the accent color.", "slots": ["s6_label", "s6_l1", "s6_l2"] },
    { "t": "10.6-12.4", "what": "What it does: a label and three words stacked, the third underlined.", "slots": ["s7_label", "s7_w1", "s7_w2", "s7_w3"] },
    { "t": "12.4-14.0", "what": "A true count and a noun, then a decoded verb.", "slots": ["s8_num", "s8_word", "s8_decode"] },
    { "t": "14.0-15.4", "what": "A label and one very big short value.", "slots": ["s9_label", "s9_val"] },
    { "t": "15.4-16.8", "what": "A friction removed: a label ending in a colon, then a big accent word.", "slots": ["s10_label", "s10_val"] },
    { "t": "16.8-18.5", "what": "What you get: a label, two stacked lines, a small sub line.", "slots": ["s11_label", "s11_l1", "s11_l2", "s11_sub"] },
    { "t": "18.5-20.3", "what": "The payoff: a lead line and a glowing accent line.", "slots": ["s12_l1", "s12_l2"] },
    { "t": "20.3-22.2", "what": "A typed payload of three factual lines: the URL, one fact, one status.", "slots": ["t1", "t2", "t3"] },
    { "t": "22.2-24.0", "what": "The lockup, held: a top line, the title in two parts (first part in the brand color), the tagline, the host.", "slots": ["lock_top", "lock_title_a", "lock_title_b", "lock_line1", "lock_line2"] }
  ],
  "slots": [
    { "id": "s1_head", "max": 24, "default": "INCOMING TRANSMISSION", "example": "INCOMING TRANSMISSION", "face": "mono", "size": 34, "selector": "#s1-head", "prefix": "// ", "hint": "framing label; the default usually works" },
    { "id": "s1_line", "max": 20, "default": "NEW BUILD DETECTED.", "example": "NEW BUILD DETECTED.", "face": "mono", "size": 86, "selector": "#s1-flick", "suffix": "  ", "hint": "the hook: something detected, spotted, incoming; ends with a period" },
    { "id": "s2_label", "max": 14, "default": "DECRYPTING…", "example": "DECRYPTING…", "face": "mono", "size": 62, "selector": "#s2-label", "hint": "one word of process, with an ellipsis" },
    { "id": "s3_label", "max": 16, "default": "MESSAGE FOR:", "example": "MESSAGE FOR:", "face": "mono", "size": 40, "selector": "#s3-label", "hint": "label ending in a colon" },
    { "id": "s3_audience", "max": 14, "default": "BUILDERS.", "example": "DEV TEAMS.", "face": "anton", "size": 168, "selector": "#s3-decode", "attr": "data-text", "hint": "the audience in one or two words plus a period, from the profile's ICP" },
    { "id": "drop_l1", "max": 14, "default": "THIS APP", "example": "PULSEBOARD", "face": "anton", "size": 222, "selector": "#drop-decode", "group": "drop", "attr": "data-text", "hint": "the app name exactly as the brand writes it" },
    { "id": "drop_l2", "max": 10, "default": "IS LIVE.", "example": "IS LIVE.", "face": "anton", "size": 222, "selector": "#drop-decode", "group": "drop", "attr": "data-text", "hint": "one or two words that complete the reveal" },
    { "id": "s6_label", "max": 14, "default": "STATUS", "example": "STATUS", "face": "mono", "size": 40, "selector": "#s6-label", "prefix": "> ", "hint": "terminal-style label" },
    { "id": "s6_l1", "max": 12, "default": "READY.", "example": "ONE CLICK.", "face": "anton", "size": 164, "selector": "#s6-hours", "hint": "the most important true fact, half one" },
    { "id": "s6_l2", "max": 12, "default": "NOW.", "example": "DEPLOYED.", "face": "anton", "size": 164, "selector": "#s6-off", "hint": "the most important true fact, half two, shown in the accent color" },
    { "id": "s7_label", "max": 14, "default": "DOES //", "example": "DOES //", "face": "mono", "size": 40, "selector": "#s7-label", "hint": "label for the three words" },
    { "id": "s7_w1", "max": 11, "default": "BUILD", "example": "MONITOR", "face": "anton", "size": 128, "selector": "#s7-w1", "hint": "what it does, word one" },
    { "id": "s7_w2", "max": 11, "default": "RUN", "example": "ALERT", "face": "anton", "size": 128, "selector": "#s7-w2", "hint": "what it does, word two" },
    { "id": "s7_w3", "max": 11, "default": "SHARE", "example": "REPORT", "face": "anton", "size": 128, "selector": "#s7-w3", "hint": "what it does, word three (underlined)" },
    { "id": "s8_num", "max": 4, "default": "ONE", "example": "12", "face": "anton", "size": 150, "selector": "#s8-top", "group": "s8top", "hint": "a true number from the profile (integrations, formats, steps); use ONE if nothing countable is known" },
    { "id": "s8_word", "max": 10, "default": "WORKFLOW", "example": "SOURCES", "face": "anton", "size": 150, "selector": "#s8-top", "group": "s8top", "hint": "the noun the number counts" },
    { "id": "s8_decode", "max": 10, "default": "INCLUDED.", "example": "CONNECTED.", "face": "anton", "size": 128, "selector": "#s8-decode", "attr": "data-text", "hint": "a verb that resolves the count, with a period" },
    { "id": "s9_label", "max": 14, "default": "PRICE:", "example": "SETUP TIME:", "face": "mono", "size": 40, "selector": "#s9-label", "hint": "label ending in a colon" },
    { "id": "s9_val", "max": 7, "default": "FREE.", "example": "2 MIN.", "face": "anton", "size": 270, "selector": "#s9-val", "hint": "a very short value: a price, a time, a size; only if true" },
    { "id": "s10_label", "max": 20, "default": "SETUP REQUIRED:", "example": "CREDIT CARD:", "face": "mono", "size": 52, "selector": "#s10-label", "hint": "a friction people expect, ending in a colon" },
    { "id": "s10_val", "max": 7, "default": "NONE.", "example": "NONE.", "face": "anton", "size": 250, "selector": "#s10-val", "hint": "the friction removed, one word, with a period" },
    { "id": "s11_label", "max": 10, "default": "YOU GET:", "example": "YOU GET:", "face": "mono", "size": 40, "selector": "#s11-label", "hint": "label ending in a colon" },
    { "id": "s11_l1", "max": 14, "default": "THE WHOLE", "example": "EVERY ALERT", "face": "anton", "size": 116, "selector": "#s11-l1", "hint": "what you get, line one" },
    { "id": "s11_l2", "max": 9, "default": "THING.", "example": "IN ONE.", "face": "anton", "size": 196, "selector": "#s11-l2", "hint": "what you get, line two, bigger" },
    { "id": "s11_sub", "max": 16, "default": "+ NO LOCK-IN", "example": "+ OPEN SOURCE", "face": "mono", "size": 58, "selector": "#s11-cash", "hint": "a small true extra, starts with a plus" },
    { "id": "s12_l1", "max": 12, "default": "+ MADE FOR", "example": "+ MADE FOR", "face": "anton", "size": 108, "selector": "#s12-l1", "hint": "lead line of the payoff" },
    { "id": "s12_l2", "max": 12, "default": "YOU.", "example": "ON-CALL.", "face": "anton", "size": 152, "selector": "#s12-l2", "hint": "the payoff word, glows in the accent color, ends with a period" },
    { "id": "t1", "max": 44, "default": "URL: SEE LINK", "example": "URL: PULSEBOARD.APP", "face": "mono", "size": 64, "selector": "#s13-payload", "js": true, "hint": "typed line one: URL: then the full site host, no protocol, never shortened" },
    { "id": "t2", "max": 26, "default": "STATUS: LIVE", "example": "STACK: OPEN SOURCE", "face": "mono", "size": 64, "selector": "#s13-payload", "js": true, "hint": "typed line two: a short key, a colon, one true product fact (category, stack, licence); never the hosting provider" },
    { "id": "t3", "max": 26, "default": "ACCESS: OPEN", "example": "ACCESS: FREE TIER", "face": "mono", "size": 64, "selector": "#s13-payload", "js": true, "hint": "typed line three: a short key, a colon, a status" },
    { "id": "lock_top", "max": 30, "default": "ON THE ROCKETRIDE APP STORE", "example": "ON THE ROCKETRIDE APP STORE", "face": "sg", "size": 48, "selector": "#s14-top", "hint": "who made it or where it lives" },
    { "id": "lock_title_a", "max": 14, "default": "THIS APP", "example": "PULSEBOARD", "face": "anton", "size": 148, "selector": "#s14-title", "group": "lock", "hint": "the app name, shown in the brand color" },
    { "id": "lock_title_b", "max": 8, "default": "LIVE", "example": "LIVE", "face": "anton", "size": 148, "selector": "#s14-title", "group": "lock", "hint": "one word after the name" },
    { "id": "lock_line1", "max": 44, "default": "NOW LIVE", "example": "UPTIME MONITORING FOR SMALL TEAMS", "face": "sg", "size": 38, "selector": "#s14-venue", "hint": "the tagline in the brand's own words" },
    { "id": "lock_line2", "max": 40, "default": "", "example": "PULSEBOARD.APP", "face": "sg", "size": 54, "selector": "#s14-date", "optional": true, "hint": "the site host, uppercase, no protocol" }
  ]
}
