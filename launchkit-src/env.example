# Frontend build flags (launchkit/frontend/.env.local)
# Set to 1 ONLY in local dev — exposes "Simulate signup", which writes fake
# attribution events to the mock store. Never set this in a build for users.
NEXT_PUBLIC_ENABLE_DEV_TOOLS=0

# RocketRide server connection (synced from VS Code extension settings)
ROCKETRIDE_URI=http://localhost:5565
ROCKETRIDE_APIKEY=your-rocketride-api-key

# Web scraping — https://firecrawl.dev
ROCKETRIDE_FIRECRAWL_KEY=fc-your-key

# Semantic web search — https://exa.ai
ROCKETRIDE_EXA_KEY=your-exa-key

# LLM for agents (at least one required)
ROCKETRIDE_OPENAI_KEY=sk-your-key
ROCKETRIDE_ANTHROPIC_KEY=sk-ant-your-key
ROCKETRIDE_GMI_KEY=your-gmi-cloud-key

# GitHub PAT (read-only is enough) — https://github.com/settings/tokens
ROCKETRIDE_GITHUB_TOKEN=github_pat_your-token

# Reddit API app (script type) — https://www.reddit.com/prefs/apps
ROCKETRIDE_REDDIT_CLIENT_ID=
ROCKETRIDE_REDDIT_SECRET=
