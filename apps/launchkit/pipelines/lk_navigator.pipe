{
  "components": [
    {
      "id": "chat_1",
      "provider": "chat",
      "name": "Chat",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "chat"
      }
    },
    {
      "id": "llm_openai_api_1",
      "provider": "llm_openai_api",
      "name": "OpenAI-Compatible API",
      "config": {
        "profile": "custom",
        "custom": {
          "apikey": "${ROCKETRIDE_ANTHROPIC_KEY}",
          "base_url": "https://api.anthropic.com/v1",
          "model": "claude-sonnet-4-6",
          "modelTotalTokens": 200000
        },
        "parameters": {}
      },
      "input": [
        {
          "lane": "questions",
          "from": "chat_1"
        }
      ]
    },
    {
      "id": "response_answers_1",
      "provider": "response_answers",
      "name": "Return Answers",
      "config": {
        "laneName": "answers"
      },
      "input": [
        {
          "lane": "answers",
          "from": "llm_openai_api_1"
        }
      ]
    }
  ],
  "project_id": "ee27311f-76b6-4f9f-ab71-c50a3b56a976",
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "version": 1
