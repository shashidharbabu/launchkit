{
  "name": "rocketride_sb-launchkit",
  "version": "0.1.0",
  "private": true,
  "description": "Launch Kit \u2014 a RocketRide app",
  "license": "MIT",
  "appManifest": {
    "id": "rocketride_sb.launchkit",
    "publisher": "rocketride_sb",
    "name": "Launch Kit",
    "description": "GTM-in-a-box for shipped apps: app profile, pricing, listing, ranked launch venues, platform-native posts, and live demand signals \u2014 three human approval gates, nothing auto-publishes, tracked-link attribution.",
    "icon": "./icon.svg",
    "readme": "./README.md",
    "categories": [
      "custom"
    ],
    "mode": "subscription",
    "authenticated": true,
    "billing": {
      "plans": [
        {
          "nickname": "Free",
          "amountCents": 0,
          "currency": "usd",
          "interval": "month"
        },
        {
          "nickname": "Pro",
          "amountCents": 2900,
          "currency": "usd",
          "interval": "month"
        }
      ]
    },
    "projectId": "7c20160e-335a-4ad1-be67-140e2fc8bf61"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "tsc --noEmit && rsbuild build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@launchkit/design-system": "workspace:*",
    "@number-flow/react": "~0.6.2",
    "@tanstack/react-table": "~9.1.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.10.1",
    "rocketride": "file:../../.rocketride/client/rocketride.tgz",
    "shell": "file:../../.rocketride/shell/shell.tgz",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "2.5.1",
    "@rsbuild/core": "~2.0.11",
    "@rsbuild/plugin-react": "~2.0.1",
    "@types/node": "^20.19.41",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react-refresh": "^0.14.2",
    "typescript": "^5.3.0"
  }
}
