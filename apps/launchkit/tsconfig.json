{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "next/link": [
        "./src/shims/next-link.tsx"
      ],
      "@launchkit/design-system/components/*": [
        "./src/ds/components/*.tsx"
      ],
      "@launchkit/design-system/motion/*": [
        "./src/ds/components/motion/*.tsx"
      ],
      "@launchkit/design-system/lib/*": [
        "./src/ds/lib/*.ts"
      ]
    }
  },
  "include": [
    "src",
    "rsbuild.config.mts"
  ]
}
